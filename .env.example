# Copy to .env and replace the placeholders with credentials you use.
# Search keys are optional; configured providers are combined for research.

# Required to read questions and submit forecasts.
METACULUS_TOKEN=REPLACE_ME

# Configure at least one LLM provider. With both, Gemini forecasts and NVIDIA
# NIM parses structured predictions.
GEMINI_API_KEY=REPLACE_ME
NVIDIA_API_KEY=REPLACE_ME

# Optional search providers. Every configured provider is queried.
EXA_API_SECRET=REPLACE_ME
PARALLEL_API_KEY=REPLACE_ME
TAVILY_API_KEY=REPLACE_ME
