# Copy to .env and replace placeholders for the credentials you use.
# NVIDIA NIM uses free-tier serverless models at integrate.api.nvidia.com/v1.

# Required to read questions and submit forecasts.
METACULUS_TOKEN=REPLACE_ME

# Configure at least one LLM provider. NVIDIA forecasting starts with
# nvidia/nemotron-3-ultra-550b-a55b and falls through its secondary free-tier roster.
# Summarization starts with minimaxai/minimax-m3.1-flash.
GEMINI_API_KEY=REPLACE_ME
NVIDIA_API_KEY=REPLACE_ME

# Optional search providers. Configured and enabled providers run in parallel.
EXA_API_SECRET=REPLACE_ME
PARALLEL_API_KEY=REPLACE_ME
TAVILY_API_KEY=REPLACE_ME

# Search sources are enabled by default when their corresponding key is set.
EXA_SEARCH_ENABLED=true
GEMINI_GROUNDED_SEARCH_ENABLED=true
PARALLEL_SEARCH_ENABLED=true
TAVILY_SEARCH_ENABLED=true

# Optionally fetch NVIDIA's live /models catalog at startup and filter the roster.
NVIDIA_MODEL_CATALOG_CHECK=false
